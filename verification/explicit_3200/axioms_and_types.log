NoEpsilon.commutator_bound_two_pow_3200 : ∀ (n : ℕ) (A : Matrix (Fin n) (Fin n) ℂ),
  A.trace = 0 → ∃ B C, A = B * C - C * B ∧ ‖B‖ * ‖C‖ ≤ 2 ^ 3200 * ‖A‖
NoEpsilon.commutator_bound_two_pow_3200_euclideanOperatorNorm : ∀ (n : ℕ) (A : Matrix (Fin n) (Fin n) ℂ),
  A.trace = 0 →
    ∃ B C,
      A = B * C - C * B ∧ ‖Matrix.toEuclideanCLM B‖ * ‖Matrix.toEuclideanCLM C‖ ≤ 2 ^ 3200 * ‖Matrix.toEuclideanCLM A‖
